{
  "extends": "@upstatement/eslint-config/react",
  "parserOptions": {
    "requireConfigFile": false,
    "babelOptions": {
      "presets": [
        "babel-preset-gatsby"
      ]
    }
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    "react/no-unknown-property": [
      "error",
      {
        "ignore": [
          "prefix"
        ]
      }
    ],
    "space-before-function-paren": "off"
  }
}
