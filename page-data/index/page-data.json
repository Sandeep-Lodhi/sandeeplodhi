min-width: 700px) 700px, 100vw"}]},"width":700,"height":313}}},"tech":["Node.js","TypeScript","Serverless Framework","AWS (Lambda, S3, CloudFront, API Gateway)","PostgreSQL","Redis","Cloudflare","Intercom","CI/CD","Sentry"],"github":"","external":"https://family.one/"},"html":"<p>Developed a family discount and networking platform connecting users with local business partners.<br>\nImplemented APIs for registration, family–business linking, and discount validation.<br>\nPerformed API load testing and integrated AI-powered chat support using Intercom.</p>"}},{"node":{"frontmatter":{"title":"Nosotrus","cover":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","backgroundColor":"#f8f8f8","images":{"fallback":{"src":"/static/f0c4c630102adea550bd1cf2280e61a8/cbfa8/nosotrus.png","srcSet":"/static/f0c4c630102adea550bd1cf2280e61a8/99118/nosotrus.png 175w,\n/static/f0c4c630102adea550bd1cf2280e61a8/18b9b/nosotrus.png 350w,\n/static/f0c4c630102adea550bd1cf2280e61a8/cbfa8/nosotrus.png 700w","sizes":"(min-width: 700px) 700px, 100vw"},"sources":[{"srcSet":"/static/f0c4c630102adea550bd1cf2280e61a8/34607/nosotrus.avif 175w,\n/static/f0c4c630102adea550bd1cf2280e61a8/d8e76/nosotrus.avif 350w,\n/static/f0c4c630102adea550bd1cf2280e61a8/e6fe1/nosotrus.avif 700w","type":"image/avif","sizes":"(min-width: 700px) 700px, 100vw"},{"srcSet":"/static/f0c4c630102adea550bd1cf2280e61a8/6ba49/nosotrus.webp 175w,\n/static/f0c4c630102adea550bd1cf2280e61a8/c8347/nosotrus.webp 350w,\n/static/f0c4c630102adea550bd1cf2280e61a8/6eb8d/nosotrus.webp 700w","type":"image/webp","sizes":"(min-width: 700px) 700px, 100vw"}]},"width":700,"height":312}}},"tech":["Node.js","Serverless Framework","PostgreSQL","Redis","Bitbucket","Cloudflare","AWS Lambda","CI/CD","Sentry","Codecov","Jira","Slack"],"github":"","external":"https://develop.nosotrosonline.com/"},"html":"<p>Built an LMS (Learning Management System) for Spanish education.<br>\nDeveloped interactive dashboards for admins, schools, teachers, parents, and students.<br>\nConfigured CI/CD pipelines with Bitbucket and integrated Sentry, Codecov, Jira, and Slack for continuous delivery and monitoring.</p>"}},{"node":{"frontmatter":{"title":"Patient Call History","cover":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","backgroundColor":"#f8f8f8","images":{"fallback":{"src":"/static/a04a6b42d8d22f018300e7906bbe22d8/1cfd0/patient-call-history.png","srcSet":"/static/a04a6b42d8d22f018300e7906bbe22d8/677c8/patient-call-history.png 175w,\n/static/a04a6b42d8d22f018300e7906bbe22d8/fbe7c/patient-call-history.png 350w,\n/static/a04a6b42d8d22f018300e7906bbe22d8/1cfd0/patient-call-history.png 700w,\n/static/a04a6b42d8d22f018300e7906bbe22d8/2facf/patient-call-history.png 1400w","sizes":"(min-width: 700px) 700px, 100vw"},"sources":[{"srcSet":"/static/a04a6b42d8d22f018300e7906bbe22d8/863c5/patient-call-history.avif 175w,\n/static/a04a6b42d8d22f018300e7906bbe22d8/d9aff/patient-call-history.avif 350w,\n/static/a04a6b42d8d22f018300e7906bbe22d8/459d9/patient-call-history.avif 700w,\n/static/a04a6b42d8d22f018300e7906bbe22d8/29467/patient-call-history.avif 1400w","type":"image/avif","sizes":"(min-width: 700px) 700px, 100vw"},{"srcSet":"/static/a04a6b42d8d22f018300e7906bbe22d8/34646/patient-call-history.webp 175w,\n/static/a04a6b42d8d22f018300e7906bbe22d8/7a43c/patient-call-history.webp 350w,\n/static/a04a6b42d8d22f018300e7906bbe22d8/d1542/patient-call-history.webp 700w,\n/static/a04a6b42d8d22f018300e7906bbe22d8/b1f71/patient-call-history.webp 1400w","type":"image/webp","sizes":"(min-width: 700px) 700px, 100vw"}]},"width":700,"height":394}}},"tech":["Node.js","Express 5","PostgreSQL","SQL Server","SQLite","Redis","React 19","IIS"],"github":"","external":""},"html":"<p>Lookup tool for call-center agents: search a phone number or patient ID and see 30 days of call history across all of that patient's numbers.\nServed through a three-tier cache (in-memory LRU, Redis, SQLite) in front of PostgreSQL, with a 15-minute incremental